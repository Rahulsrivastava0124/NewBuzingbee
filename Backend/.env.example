# Copy to .env and fill in. Never commit real values.

# --- Server ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
BODY_SIZE_LIMIT=5mb
# Public URL of the admin panel; used for links in password-reset emails
ADMIN_PANEL_URL=https://admin.buzingbee.com
# Comma-separated browser origins allowed to call the API (site + admin panel).
# Empty = allow every origin.
CORS_ORIGINS=https://buzingbee.com,https://www.buzingbee.com,https://admin.buzingbee.com
# Set to 1 when running behind nginx / a load balancer (rate limits + client IP)
TRUST_PROXY=1

# --- Database -------------------------------------------------------------
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DBNAME

# --- Auth -----------------------------------------------------------------
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=10d
# Used once to create the first admin when none exists yet
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# --- Cloudflare R2 (optional; without it uploads are served from /uploads) --
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# --- Logging --------------------------------------------------------------
# Per-request blog trace log (off by default in production)
BLOG_TRACE_ENABLED=false

# --- Bot protection (Cloudflare Turnstile, optional) ----------------------
# Secret key from the Cloudflare dashboard. When set, the enquiry form must send
# a valid captchaToken. Put the matching site key in the website's
# NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
